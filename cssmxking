    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 700px;
      margin: 50px auto;
      padding: 30px;
      background: white;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      border-radius: 10px;
    }

    h2 {
      text-align: center;
      color: #2c3e50;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 10px;
      margin: 10px 0;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      background-color: #1e90ff;
      color: white;
      padding: 10px;
      width: 100%;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background-color: #0077cc;
    }

    nav {
      text-align: center;
      margin-bottom: 20px;
    }

    nav button {
      margin: 5px;
      padding: 10px 15px;
      background-color: #3498db;
      border: none;
      color: white;
      border-radius: 5px;
    }

    nav button:hover {
      background-color: #2980b9;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .error {
      color: red;
      text-align: center;
    }

    .product-img {
      width: 100%;
      max-width: 500px;
      display: block;
      margin: 20px auto;
      border-radius: 10px;
    }

    .hidden {
      display: none;
    }